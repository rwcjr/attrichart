{
  "name": "@attrichart/react",
  "version": "0.1.0",
  "description": "React component for AttriChart overlapping attribution flow charts.",
  "license": "MIT",
  "author": "Robert Coleman",
  "homepage": "https://github.com/rwcjr/attrichart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rwcjr/attrichart.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/rwcjr/attrichart/issues"
  },
  "keywords": [
    "sankey",
    "attribution",
    "multi-touch",
    "marketing",
    "funnel",
    "flow",
    "chart",
    "dataviz",
    "react",
    "component"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@attrichart/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
